{
  "appId": "dev.vzstudio.rubcub",
  "appName": "RubCub",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#0b0b0f",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#0b0b0f",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}
