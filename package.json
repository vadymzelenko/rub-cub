{
  "name": "rubcub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RubCub — Rubik's Cube scanner and solver. React + Vite PWA, packaged for Android with Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor '#0b0b0f' --iconBackgroundColorDark '#0b0b0f' --splashBackgroundColor '#0b0b0f' --splashBackgroundColorDark '#0b0b0f'"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/inter": "^5.3.0",
    "cubejs": "^1.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "three": "^0.169.0"
  },
  "engines": {
    "node": ">=22"
  }
}
